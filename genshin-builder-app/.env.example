# Prisma（開発: SQLite）
DATABASE_URL="file:./dev.db"

# POST /api/sync と設定画面の手動同期に共通で使う認証シークレット
# 本番では必須。設定画面では実行時に同じ値を入力する。
# SYNC_API_SECRET="your-random-secret-here"

# AZA.GG 深境螺旋統計（公開KV API。現在はAPIキー不要）
AZA_API_BASE_URL="https://c1-api.aza.gg"
AZA_ABYSS_ENABLED="true"
AZA_CACHE_TTL_SECONDS="21600"
AZA_REQUEST_TIMEOUT_MS="10000"

# Flutter release buildからこのNext.js backendへ接続するための公開origin。
# ReleaseではGitHub Secretへ同名で登録し、HTTPSを必須とする。AZA.GGのURLではない。
# 以下は秘密情報を含まないダミー値。localhostはローカル開発時のdart-defineだけで使用する。
GENSHIN_BUILDER_API_BASE_URL="https://builder.example.com"

# gcsim 編成推薦（既定は無効。固定バイナリとmigration確認後だけ有効化する）
GCSIM_ENABLED="false"
GCSIM_MAX_CANDIDATES="20"
GCSIM_MAX_CONCURRENCY="2"
GCSIM_MAX_ACTIVE_JOBS="8"
GCSIM_TIMEOUT_SECONDS="30"
GCSIM_ITERATIONS="1000"
GCSIM_CACHE_TTL_SECONDS="86400"
GCSIM_JOB_TTL_SECONDS="86400"
GCSIM_MAX_CONFIG_BYTES="65536"
GCSIM_MAX_OUTPUT_BYTES="2097152"
GCSIM_DURATION_SECONDS="90"

# 推薦スコア係数（合計1.0でない場合は安全な既定値へ戻る）
GCSIM_SCORE_PERFORMANCE="0.35"
GCSIM_SCORE_OBSERVED="0.20"
GCSIM_SCORE_BUILD="0.15"
GCSIM_SCORE_STABILITY="0.10"
GCSIM_SCORE_ENERGY="0.10"
GCSIM_SCORE_ACCESSIBILITY="0.10"

# 承認済み編成テンプレート管理API（必須・未設定時は常に503でfail closed）
# Authorization: Bearer <TEAM_TEMPLATE_ADMIN_SECRET>
# TEAM_TEMPLATE_ADMIN_SECRET="your-separate-random-secret-here"

# 取得元URLを保存する場合のHTTPSホスト許可リスト。本文は保存・公開しない。
# 正式URLと利用許可を確認するまでは空のままにする。
TEAM_SOURCE_ALLOWED_HOSTS=""

# DeepSeekによる入れ替え候補の事前評価（既定は無効）
# 現行の許可モデルは deepseek-v4-flash / deepseek-v4-pro のみ。
DEEPSEEK_ENABLED="false"
# DEEPSEEK_API_KEY="server-side-secret"
DEEPSEEK_MODEL="deepseek-v4-flash"
DEEPSEEK_TIMEOUT_MS="45000"
DEEPSEEK_MAX_ATTEMPTS="3"
TEAM_REPLACEMENT_MAX_CANDIDATES="16"

# ---- Build Guide（YouTube metadata + Gemini visual OCR + DeepSeek merge）----
# 管理 API。未設定時は常に 503 fail-closed。TEAM_TEMPLATE_ADMIN_SECRET とは別シークレットを推奨。
# Authorization: Bearer <BUILD_GUIDE_ADMIN_SECRET>
# BUILD_GUIDE_ADMIN_SECRET="your-separate-build-guide-admin-secret"

# YouTube Data API（メタデータ同期のみ。固定ホスト youtube.googleapis.com。既定は無効）
YOUTUBE_GUIDE_ENABLED="false"
# YOUTUBE_API_KEY="server-side-youtube-api-key"
YOUTUBE_TIMEOUT_MS="15000"

# Gemini 映像解析（公開 YouTube URL を直接渡す。動画ダウンロードなし。既定は無効）
GEMINI_VIDEO_ANALYSIS_ENABLED="false"
# GEMINI_API_KEY="server-side-gemini-api-key"
# 許可モデル例（公式 Video understanding の YouTube URL 例に合わせる）:
# gemini-3.6-flash / gemini-2.5-flash / gemini-2.5-pro / gemini-2.0-flash
GEMINI_VIDEO_ANALYSIS_MODEL="gemini-3.6-flash"
GEMINI_VIDEO_ANALYSIS_TIMEOUT_MS="180000"
GEMINI_VIDEO_ANALYSIS_MAX_ATTEMPTS="2"
GEMINI_VIDEO_MAX_DURATION_SECONDS="3600"

# 検証済み映像証拠の統合専用 DeepSeek（動画本体は解析しない。既定は無効）
DEEPSEEK_GUIDE_ANALYSIS_ENABLED="false"
# DEEPSEEK_GUIDE_ANALYSIS_API_KEY="server-side-secret"
DEEPSEEK_GUIDE_ANALYSIS_MODEL="deepseek-v4-pro"
DEEPSEEK_GUIDE_ANALYSIS_TIMEOUT_MS="60000"
DEEPSEEK_GUIDE_ANALYSIS_MAX_ATTEMPTS="3"
