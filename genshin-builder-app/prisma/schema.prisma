// Prisma schema (PostgreSQL)
// Dev/CI/staging use PostgreSQL. SQLite history is in prisma/migrations-sqlite-archive.
// For Neon pooled connections, set DATABASE_URL (pooler) and DIRECT_URL (direct).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// マスターデータ（外部APIから同期して保存する）
// ============================================================

/// キャラクターの基本情報
model Character {
  id         String   @id // APIのスラッグ（例: "hu-tao"）
  name       String
  element    String // 元素（pyro / hydro / electro / cryo / anemo / geo / dendro）
  weaponType String // 武器種（sword / claymore / polearm / bow / catalyst）
  rarity     Int // レアリティ（4 or 5）
  region     String // 出身地域（Mondstadt など）
  iconUrl    String // アイコン画像URL
  scoreType  String @default("atk") // 聖遺物スコア計算タイプ（atk / hp / def / em）
  syncedAt   DateTime @updatedAt // 最終同期日時

  upgrade CharacterUpgrade?
  progresses UserProgress[]
}

/// 武器の基本情報
model Weapon {
  id         String   @id
  name       String
  weaponType String
  rarity     Int
  iconUrl    String
  syncedAt   DateTime @updatedAt

  upgrade WeaponUpgrade?
}

/// 素材の基本情報
model Material {
  id        String   @id
  name      String
  category  String // 種類（talent-book / boss-material / local-specialties など）
  rarity    Int? // レアリティ（APIに存在する場合のみ）
  iconUrl   String
  expValue  Int? // 経験値（キャラ/武器強化素材。API material detail から取得）
  expTarget String? // character / weapon（経験値素材の対象）
  syncedAt  DateTime @updatedAt
}

/// キャラクター突破・天賦強化データ（API avatar detail から同期）
model CharacterUpgrade {
  characterId String    @id
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  /// JSON: PromoteStage[]（突破段階ごとの costItems / coinCost）
  promotes    String
  /// JSON: TalentUpgradeData[]（スキル種別ごとのレベル別 costItems）
  talents     String
  syncedAt    DateTime  @updatedAt
}

/// 武器突破データ（API weapon detail から同期）
model WeaponUpgrade {
  weaponId String @id
  weapon   Weapon @relation(fields: [weaponId], references: [id], onDelete: Cascade)
  /// JSON: PromoteStage[]
  promotes String
  /// JSON: string[]（レベルアップ用魔鉱などの material ID）
  levelUpItemIds String @default("[]")
  syncedAt DateTime @updatedAt
}

/// 目盛り間の必要EXP（character=全キャラ共通 rarity0 / weapon=レアリティ別）
model LevelExpSegment {
  id          String @id // 例: character-0-1-20, weapon-5-40-50
  targetType  String // character / weapon
  rarity      Int    @default(0)
  fromLevel   Int
  toLevel     Int
  expRequired Int
  moraRequired Int
  syncedAt    DateTime @updatedAt

  @@unique([targetType, rarity, fromLevel, toLevel])
}

// ============================================================
// ユーザーデータ（マスターデータとは別管理）
// ============================================================

/// ユーザーごとのキャラクター育成状況
/// Ver.1 ではログインなし。ブラウザに保存した匿名IDを userId として使う。
model UserProgress {
  id          String  @id @default(cuid())
  userId      String // 匿名ユーザーID
  characterId String
  character   Character @relation(fields: [characterId], references: [id])

  level       Int     @default(1) // レベル (1-90)
  ascension   Int     @default(0) // 突破段階 (0-6)
  constellation Int   @default(0) // 命ノ星座（凸数 0-6）
  talentNormal Int    @default(1) // 天賦：通常攻撃 (1-10)
  talentSkill  Int    @default(1) // 天賦：元素スキル (1-10)
  talentBurst  Int    @default(1) // 天賦：元素爆発 (1-10)
  weaponId    String  @default("") // 装備武器のマスターID
  weaponName  String  @default("") // 装備武器名（表示用）
  weaponLevel Int     @default(1) // 武器レベル (1-90)
  weaponRefinement Int @default(1) // 精錬ランク (1-5)
  artifacts   String  @default("") // 聖遺物データ（JSON文字列。SQLiteはJson型非対応のため）
  isCompleted Boolean @default(false) // 育成完了フラグ
  memo        String  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 同じユーザーが同じキャラを重複登録できないようにする
  @@unique([userId, characterId])
  @@index([userId])
}

/// マスターデータ同期の実行履歴（デバッグ・Cron監視用）
model SyncLog {
  id        Int      @id @default(autoincrement())
  status    String // "success" / "error"
  detail    String // 同期件数やエラーメッセージ
  createdAt DateTime @default(now())
}

/// マスタ同期の分散リースロック（複数インスタンス間の排他）
model SyncLease {
  lockKey     String   @id
  ownerToken  String
  acquiredAt  DateTime
  expiresAt   DateTime
}

/// 外部APIの最終正常レスポンス（障害時フォールバック用）
model ExternalApiCache {
  cacheKey   String   @id
  source     String
  version    String
  sampleSize Int
  payload    String
  fetchedAt  DateTime
  expiresAt  DateTime
  updatedAt  DateTime @updatedAt
}

/// おすすめ編成生成Job。HoYoLABのUID/Cookie/未加工レスポンスは保存しない。
model TeamSimulationJob {
  id           String   @id
  requestHash  String
  attackerId   String
  status       String
  result       String   @default("")
  errorCode    String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  expiresAt    DateTime

  @@index([requestHash, status])
  @@index([expiresAt])
}

// ============================================================
// 承認済み編成テンプレートと事前生成済み入れ替え候補
// ============================================================

/// 取得元の原本と正規化結果。外部データを公開用データから分離する。
model ImportedTeam {
  id                String    @id @default(cuid())
  source            String
  sourceTeamId      String
  name              String
  archetype         String    @default("")
  teamHash          String
  sourceUrl         String    @default("")
  sourceUpdatedAt   DateTime?
  fetchedAt         DateTime
  rawPayload        String
  normalizedPayload String
  dataVersion       String
  approvalStatus    String    @default("pending")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  members  ImportedTeamMember[]
  template TeamTemplate?

  @@unique([source, sourceTeamId])
  @@index([teamHash])
  @@index([approvalStatus])
}

model ImportedTeamMember {
  id             String       @id @default(cuid())
  importedTeamId String
  importedTeam   ImportedTeam @relation(fields: [importedTeamId], references: [id], onDelete: Cascade)
  characterId    String
  sourceRole     String       @default("")
  normalizedRole String
  slotIndex      Int

  @@unique([importedTeamId, slotIndex])
  @@index([characterId])
}

/// 管理者が承認し、Flutterへ公開できる加工済みテンプレート。
model TeamTemplate {
  id             String       @id @default(cuid())
  importedTeamId String       @unique
  importedTeam   ImportedTeam @relation(fields: [importedTeamId], references: [id], onDelete: Restrict)
  name           String
  archetype      String       @default("")
  teamHash       String
  dataVersion    String
  status         String       @default("draft")
  sourceUrl      String       @default("")
  manualOverride String       @default("")
  publishedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  members            TeamTemplateMember[]
  replacementJobs    TeamReplacementJob[]
  replacementResults TeamReplacementResult[]

  @@unique([teamHash])
  @@index([status, updatedAt])
}

model TeamTemplateMember {
  id             String       @id @default(cuid())
  templateId     String
  template       TeamTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  characterId    String
  sourceRole     String       @default("")
  normalizedRole String
  slotIndex      Int

  @@unique([templateId, slotIndex])
  @@index([characterId])
}

/// 編成判断専用の承認済み構造化プロフィール。
model CharacterTeamProfile {
  characterId String   @id
  payload     String
  dataVersion String
  gameVersion String
  isLeak      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([dataVersion])
}

model TeamReplacementJob {
  id           String       @id
  templateId   String
  template     TeamTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  status       String
  attempts     Int          @default(0)
  cacheHits    Int          @default(0)
  successCount Int          @default(0)
  failureCount Int          @default(0)
  usagePayload String       @default("")
  errorCode    String       @default("")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  completedAt  DateTime?

  @@index([templateId, status])
  @@index([createdAt])
}

/// キャッシュキーに全バージョンを含む、最後に検証を通過した結果。
model TeamReplacementResult {
  cacheKey             String       @id
  templateId           String
  template             TeamTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  replacedCharacterId  String
  teamHash             String
  gameDataVersion      String
  characterDataVersion String
  promptVersion        String
  rulesVersion         String
  modelIdentifier      String
  status               String
  slotAnalysis         String
  rawAiOutput          String       @default("")
  validatedPayload     String
  errorCode            String       @default("")
  generatedAt          DateTime
  updatedAt            DateTime     @updatedAt

  candidates TeamReplacementCandidate[]

  @@index([templateId, replacedCharacterId, generatedAt])
  @@index([status])
}

model TeamReplacementCandidate {
  id                   String                @id @default(cuid())
  resultKey            String
  result               TeamReplacementResult @relation(fields: [resultKey], references: [cacheKey], onDelete: Cascade)
  characterId          String
  compatibilityScore   Int
  category             String
  confidence           Float
  reasons              String
  tradeoffs            String
  requiredChanges      String
  teamEvaluation       String
  deterministicPenalty Int                   @default(0)
  finalScore           Int
  sortOrder            Int

  @@unique([resultKey, characterId])
  @@index([resultKey, sortOrder])
}

model TeamImportLog {
  id        Int      @id @default(autoincrement())
  source    String
  action    String
  status    String
  detail    String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ============================================================
// Build Guide recommendations (YouTube metadata + Gemini visual OCR)
// JSON fields use String columns (SQLite-compatible).
// Video files / frames / audio are NEVER persisted.
// ============================================================

model GuideChannel {
  id                   String    @id @default(cuid())
  channelId            String    @unique
  title                String
  description          String    @default("")
  customUrl            String    @default("")
  thumbnailUrl         String    @default("")
  enabled              Boolean   @default(true)
  permissionStatus     String    @default("unknown")
  attributionRequired  Boolean   @default(true)
  notes                String    @default("")
  dailyAnalysisLimit   Int       @default(20)
  lastFetchedAt        DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  videos GuideVideo[]

  @@index([enabled, permissionStatus])
}

model GuideVideo {
  id               String    @id @default(cuid())
  videoId          String    @unique
  channelId        String
  channel          GuideChannel @relation(fields: [channelId], references: [channelId], onDelete: Cascade)
  title            String
  description      String    @default("")
  publishedAt      DateTime?
  thumbnailUrl     String    @default("")
  durationSeconds  Int?
  privacyStatus    String    @default("unknown")
  metadataHash     String    @default("")
  sourceUrl        String
  language         String    @default("")
  discoveredAt     DateTime  @default(now())
  discoveryReason  String    @default("")
  availabilityStatus String  @default("available")
  unavailableSince DateTime?
  analysisStatus   String    @default("pending")
  lastAnalyzedAt   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  jobs            GuideVisualAnalysisJob[]
  results         GuideVisualAnalysisResult[]
  evidences       GuideVisualEvidence[]
  claims          GuideVisualExtractedClaim[]
  sourceLinks     GuideAnalysisSourceVideo[]
  contributions   RecommendationVisualContribution[]
  transcripts     GuideTranscript[]
  pipelineItems   GuidePipelineItem[]

  @@index([channelId, publishedAt])
  @@index([analysisStatus])
  @@index([privacyStatus])
}

model GuideVisualAnalysisJob {
  id              String    @id @default(cuid())
  videoId         String
  video           GuideVideo @relation(fields: [videoId], references: [videoId], onDelete: Cascade)
  requestHash     String
  status          String
  providerId      String    @default("")
  modelIdentifier String    @default("")
  promptVersion   String    @default("")
  schemaVersion   String    @default("")
  gameDataVersion String    @default("")
  attempts        Int       @default(0)
  tokenUsage      String    @default("")
  errorCode       String    @default("")
  rangesPayload   String    @default("")
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([videoId, status])
  @@index([requestHash])
  @@index([createdAt])
}

model GuideVisualAnalysisResult {
  id               String   @id @default(cuid())
  cacheKey         String   @unique
  videoId          String
  video            GuideVideo @relation(fields: [videoId], references: [videoId], onDelete: Cascade)
  requestHash      String
  providerId       String
  modelIdentifier  String
  promptVersion    String
  schemaVersion    String
  gameDataVersion  String
  inputKind        String   @default("visual")
  transcriptId     String?
  transcript       GuideTranscript? @relation(fields: [transcriptId], references: [id], onDelete: SetNull)
  analysisIdempotencyKey String? @unique
  status           String
  rawAiOutput      String   @default("")
  validatedPayload String   @default("")
  errorCode        String   @default("")
  generatedAt      DateTime
  updatedAt        DateTime @updatedAt

  evidences GuideVisualEvidence[]

  @@index([videoId, status])
  @@index([status])
  @@index([transcriptId])
}

model GuideVisualEvidence {
  id                 String   @id @default(cuid())
  analysisResultId   String
  analysisResult     GuideVisualAnalysisResult @relation(fields: [analysisResultId], references: [id], onDelete: Cascade)
  videoId            String
  video              GuideVideo @relation(fields: [videoId], references: [videoId], onDelete: Cascade)
  startSeconds       Float
  endSeconds         Float
  evidenceType       String
  normalizedPayload  String   @default("{}")
  exactVisibleText   String   @default("")
  confidence         Float    @default(0)
  validationStatus   String   @default("pending")
  approvalStatus     String   @default("pending_review")
  exclusionCode      String   @default("")
  purposeSummary     String   @default("")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  visibleTexts  GuideVisualVisibleText[]
  claims        GuideVisualExtractedClaim[]
  contributions RecommendationVisualContribution[]

  @@index([videoId, startSeconds])
  @@index([analysisResultId])
  @@index([approvalStatus, validationStatus])
}

model GuideVisualVisibleText {
  id         String @id @default(cuid())
  evidenceId String
  evidence   GuideVisualEvidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  text       String
  category   String @default("other")
  confidence Float  @default(0)

  @@index([evidenceId])
}

model GuideVisualExtractedClaim {
  id             String   @id @default(cuid())
  evidenceId     String
  evidence       GuideVisualEvidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  videoId        String
  video          GuideVideo @relation(fields: [videoId], references: [videoId], onDelete: Cascade)
  characterId    String
  claimKey       String
  claimPayload   String
  purpose        String   @default("unknown")
  confidence     Float    @default(0)
  status         String   @default("extracted")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([videoId, characterId])
  @@index([evidenceId])
  @@index([characterId, claimKey])
}

model GuideAnalysisSourceManifest {
  id               String   @id @default(cuid())
  characterId      String
  videoIdsPayload  String
  manifestHash     String   @unique
  status           String   @default("draft")
  mergePayload     String   @default("")
  conflictPayload  String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  videos GuideAnalysisSourceVideo[]
  recommendations CharacterBuildRecommendation[]

  @@index([characterId, status])
}

model GuideAnalysisSourceVideo {
  id         String @id @default(cuid())
  manifestId String
  manifest   GuideAnalysisSourceManifest @relation(fields: [manifestId], references: [id], onDelete: Cascade)
  videoId    String
  video      GuideVideo @relation(fields: [videoId], references: [videoId], onDelete: Cascade)
  sortOrder  Int      @default(0)

  @@unique([manifestId, videoId])
  @@index([videoId])
}

model CharacterBuildRecommendation {
  id                 String    @id @default(cuid())
  characterId        String
  status             String    @default("pending_review")
  origin             String    @default("single_video")
  manifestId         String?
  manifest           GuideAnalysisSourceManifest? @relation(fields: [manifestId], references: [id], onDelete: SetNull)
  contextPayload     String    @default("{}")
  mainStatsPayload   String    @default("[]")
  priorityPayload    String    @default("[]")
  targetsPayload     String    @default("[]")
  /// weapons / artifactRecommendations / investmentPriority / gameVersion
  structuredPayload  String    @default("{}")
  overallConfidence  Float     @default(0)
  notes              String    @default("")
  adminNotes         String    @default("")
  automationKey      String?   @unique
  publicationKey     String?   @unique
  verificationMode  String    @default("manual")
  qualityScore       Float     @default(0)
  validationPayload  String    @default("{}")
  publishedAt        DateTime?
  lastVerifiedAt     DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  contributions RecommendationVisualContribution[]
  revisions     GuideRecommendationRevision[]

  @@index([characterId, status])
  @@index([status, publishedAt])
}

model RecommendationVisualContribution {
  id                    String @id @default(cuid())
  recommendationId      String
  recommendation        CharacterBuildRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  evidenceId            String
  evidence              GuideVisualEvidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  videoId               String
  video                 GuideVideo @relation(fields: [videoId], references: [videoId], onDelete: Cascade)
  startSeconds          Float
  endSeconds            Float
  exactVisibleText      String
  contributionRole      String @default("supporting")
  decision              String @default("adopted")
  decisionSummary       String @default("")
  usedInPublishedResult Boolean @default(false)

  @@index([recommendationId, usedInPublishedResult])
  @@index([evidenceId])
  @@index([videoId])
}

model GuideRecommendationRevision {
  id               String   @id @default(cuid())
  recommendationId String
  recommendation   CharacterBuildRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  action           String
  actionKey        String?  @unique
  actor            String   @default("admin")
  pipelineRunId    String?
  publicationKey   String?
  snapshotHash     String   @default("")
  etag             String   @default("")
  validationPayload String  @default("{}")
  beforePayload    String   @default("")
  afterPayload     String   @default("")
  createdAt        DateTime @default(now())

  @@index([recommendationId, createdAt])
  @@index([pipelineRunId])
  @@index([publicationKey])
}

model GuideAdminAuditLog {
  id        Int      @id @default(autoincrement())
  actionKey String?  @unique
  pipelineRunId String?
  actor     String   @default("admin")
  action    String
  status    String
  detail    String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([pipelineRunId])
}

model GuideImportLog {
  id        Int      @id @default(autoincrement())
  source    String
  action    String
  status    String
  detail    String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model GuideVisualUsageLog {
  id              Int      @id @default(autoincrement())
  channelId       String   @default("")
  videoId         String   @default("")
  providerId      String
  modelIdentifier String
  success         Boolean
  tokenUsage      String   @default("")
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([channelId, createdAt])
  @@index([videoId, createdAt])
}

// ============================================================
// Durable YouTube guide automation pipeline.
// Transcript text is internal-only and must never be returned by public DTOs.
// ============================================================

model GuidePipelineRun {
  id             String    @id @default(cuid())
  pipelineRunId  String    @unique
  idempotencyKey String    @unique
  trigger        String
  mode           String    @default("dry_run")
  status         String    @default("running")
  dryRun         Boolean   @default(true)
  policyVersion  String
  policyHash     String
  summaryPayload String    @default("{}")
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  items  GuidePipelineItem[]
  events GuidePipelineEvent[]

  @@index([status, startedAt])
  @@index([createdAt])
}

model GuidePipelineItem {
  id                 String    @id @default(cuid())
  runId              String
  run                GuidePipelineRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  activeRunId        String    @default("")
  lastRunId          String    @default("")
  videoId            String
  video              GuideVideo @relation(fields: [videoId], references: [videoId], onDelete: Cascade)
  characterId        String    @default("")
  discoveryKey       String    @unique
  analysisIdempotencyKey String? @unique
  publicationKey     String?   @unique
  transcriptId       String?
  transcript         GuideTranscript? @relation(fields: [transcriptId], references: [id], onDelete: SetNull)
  status             String    @default("DISCOVERED")
  resumeStatus       String    @default("")
  stateVersion       Int       @default(0)
  leaseOwner         String    @default("")
  leaseVersion       Int       @default(0)
  attempts           Int       @default(0)
  maxAttempts        Int       @default(3)
  nextRetryAt        DateTime?
  metadataHash       String    @default("")
  transcriptHash     String    @default("")
  analyzerVersion    String    @default("")
  promptVersion      String    @default("")
  schemaVersion      String    @default("")
  blockCode          String    @default("")
  safeErrorCode      String    @default("")
  qualityPayload     String    @default("{}")
  canonicalAnalysisPayload String @default("{}")
  validationHash     String    @default("")
  snapshotPayload    String    @default("{}")
  policyHash         String    @default("")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  events GuidePipelineEvent[]

  @@unique([runId, videoId])
  @@index([status, nextRetryAt])
  @@index([videoId, status])
  @@index([characterId, status])
  @@index([activeRunId, status])
  @@index([transcriptId])
}

model GuidePipelineEvent {
  id            String    @id @default(cuid())
  actionKey     String    @unique
  runId         String
  run           GuidePipelineRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  itemId        String?
  item          GuidePipelineItem? @relation(fields: [itemId], references: [id], onDelete: Cascade)
  actor         String    @default("system:youtube-automation")
  fromStatus    String    @default("")
  toStatus      String
  safeCode      String    @default("")
  detailPayload String    @default("{}")
  createdAt     DateTime  @default(now())

  @@index([runId, createdAt])
  @@index([itemId, createdAt])
}

model GuideTranscript {
  id                 String    @id @default(cuid())
  videoId            String
  video              GuideVideo @relation(fields: [videoId], references: [videoId], onDelete: Cascade)
  identityKey        String    @unique
  transcriptHash     String    @unique
  providerId         String
  language           String
  trackKind          String
  sourceTrackId      String    @default("")
  segmentCount       Int
  fetchedAt          DateTime
  retentionExpiresAt DateTime?
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  segments        GuideTranscriptSegment[]
  analysisResults GuideVisualAnalysisResult[]
  pipelineItems   GuidePipelineItem[]

  @@unique([videoId, language, transcriptHash])
  @@index([videoId, fetchedAt])
  @@index([retentionExpiresAt])
}

model GuideTranscriptSegment {
  id              String   @id @default(cuid())
  transcriptId    String
  transcript      GuideTranscript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  segmentIndex    Int
  segmentKey      String   @unique
  startSeconds    Float
  durationSeconds Float
  text            String
  textHash        String
  createdAt       DateTime @default(now())

  @@unique([transcriptId, segmentIndex])
  @@index([transcriptId, startSeconds])
}

model GuidePipelineLease {
  lockKey         String   @id
  leaseOwner      String
  leaseAcquiredAt DateTime
  leaseExpiresAt  DateTime
  leaseVersion    Int      @default(1)
  updatedAt       DateTime @updatedAt

  @@index([leaseExpiresAt])
}

model GuideProviderCircuit {
  providerId      String    @id
  state           String    @default("closed")
  failureCount    Int       @default(0)
  lastErrorCode   String    @default("")
  openedAt        DateTime?
  openUntil       DateTime?
  probeOwner      String    @default("")
  probeToken      Int       @default(0)
  probeAcquiredAt DateTime?
  probeExpiresAt  DateTime?
  stateVersion    Int       @default(0)
  updatedAt       DateTime  @updatedAt

  @@index([state, openUntil])
  @@index([state, probeExpiresAt])
}

model GuideAutomationControl {
  id               String   @id
  emergencyStopped Boolean  @default(false)
  reason           String   @default("")
  version          Int      @default(0)
  updatedAt        DateTime @updatedAt
}
