# Vercel Staging Environment Variable Template
# --------------------------------------------
# 用途: staging 専用 Vercel project の Environment Variables にコピーして使う。
# 注意:
# - 実シークレットをこのファイルへ書かない（プレースホルダのまま Vercel UI に貼る）
# - production project には登録しない
# - コミット前に実値が混入していないこと
# 参照: docs/STAGING_SETUP.md / genshin-builder-app/.env.example

# ---- Required (staging) ----
# Neon staging branch の pooled URL（実値は Vercel / Neon から取得。ここに書かない）
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require"

# Neon staging branch の direct URL（Prisma Migrate 用。pooler ではない方）
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Build Guide 管理 API Bearer（production と別値）
BUILD_GUIDE_ADMIN_SECRET="replace-with-staging-only-random-secret"

# 既存 sync 管理シークレット（production と別値）
SYNC_API_SECRET="replace-with-staging-only-sync-secret"

# staging の HTTPS origin（デプロイ後の URL に合わせる）
GENSHIN_BUILDER_API_BASE_URL="https://staging-sable.vercel.app"

# ---- Kill switches（staging smoke 中は必ず false）----
YOUTUBE_GUIDE_ENABLED="false"
YOUTUBE_DISCOVERY_ENABLED="false"
YOUTUBE_AUTOMATION_ENABLED="false"
YOUTUBE_AUTO_PUBLISH_ENABLED="false"
YOUTUBE_MAINTENANCE_ENABLED="false"
GEMINI_VIDEO_ANALYSIS_ENABLED="false"
DEEPSEEK_GUIDE_ANALYSIS_ENABLED="false"

# ---- Optional / keep OFF on staging unless explicitly approved ----
# YOUTUBE_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_GUIDE_ANALYSIS_API_KEY=
# DEEPSEEK_API_KEY=
DEEPSEEK_ENABLED="false"
AZA_ABYSS_ENABLED="true"
# Staging: Vercel cannot reach AZA (403). Serve DB cache only; GHA posts ingest.
AZA_LIVE_FETCH_ENABLED="false"
# Required for GHA → staging ingest (same value as GitHub secret STAGING_ABYSS_INGEST_SECRET)
# ABYSS_INGEST_SECRET="replace-with-staging-only-abyss-ingest-secret"
# Optional when live fetch is off (kept for local/debug parity)
# AZA_API_BASE_URL="https://c1-api.aza.gg"

# おすすめ編成（AZA/ルール。gcsim は廃止済み。未設定ならコード内既定値）
# TEAM_RECOMMENDATION_MAX_CANDIDATES="20"
# TEAM_RECOMMENDATION_MAX_ACTIVE_JOBS="8"
# TEAM_RECOMMENDATION_JOB_TTL_SECONDS="86400"

# 編成テンプレート管理を staging で触る場合のみ（未設定なら 503）
# TEAM_TEMPLATE_ADMIN_SECRET="replace-with-staging-only-team-template-secret"
TEAM_SOURCE_ALLOWED_HOSTS=""
